{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Registered ThriftHub user account with delivery details and RBAC role.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "photoURL": {
          "type": "string",
          "maxLength": 1000
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin"]
        },
        "phone": {
          "type": "string",
          "maxLength": 30
        },
        "address": {
          "type": "string",
          "maxLength": 250
        },
        "city": {
          "type": "string",
          "maxLength": 100
        },
        "postalCode": {
          "type": "string",
          "maxLength": 20
        },
        "isSuspended": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "photoURL", "role", "isSuspended", "createdAt", "updatedAt"]
    },
    "AdminEntry": {
      "title": "AdminEntry",
      "description": "Authoritative admin membership record keyed by user UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 200
        },
        "grantedBy": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "grantedBy", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Secondhand clothing or accessory item listed by a seller in PHP.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sellerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sellerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1200
        },
        "category": {
          "type": "string",
          "enum": ["T-Shirts", "Jeans", "Jackets", "Hoodies", "Shoes", "Accessories"]
        },
        "size": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "condition": {
          "type": "string",
          "enum": ["New with Tags", "Like New", "Gently Used", "Vintage Worn"]
        },
        "pricePhp": {
          "type": "number"
        },
        "imageUrl": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400000
        },
        "featured": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["available", "sold", "archived"]
        },
        "soldOrderId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^(|[a-zA-Z0-9_\\-]+)$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "sellerId", "sellerName", "title", "description", "category", "size", "condition", "pricePhp", "imageUrl", "featured", "status", "soldOrderId", "createdAt", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer Cash-on-Delivery order containing purchased thrift items.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "buyerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "buyerEmail": {
          "type": "string",
          "maxLength": 200
        },
        "buyerName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "sellerIds": {
          "type": "array"
        },
        "items": {
          "type": "array"
        },
        "subtotalPhp": {
          "type": "number"
        },
        "shippingFeePhp": {
          "type": "number"
        },
        "totalPhp": {
          "type": "number"
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["COD"]
        },
        "deliveryName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "deliveryPhone": {
          "type": "string",
          "minLength": 7,
          "maxLength": 30
        },
        "deliveryAddress": {
          "type": "string",
          "minLength": 5,
          "maxLength": 250
        },
        "deliveryCity": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "deliveryPostalCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 20
        },
        "deliveryNotes": {
          "type": "string",
          "maxLength": 300
        },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "shipped", "delivered", "cancelled"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "buyerId", "buyerEmail", "buyerName", "sellerIds", "items", "subtotalPhp", "shippingFeePhp", "totalPhp", "paymentMethod", "deliveryName", "deliveryPhone", "deliveryAddress", "deliveryCity", "deliveryPostalCode", "deliveryNotes", "status", "createdAt", "updatedAt"]
    },
    "Cart": {
      "title": "Cart",
      "description": "Persisted shopping bag for an authenticated buyer.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "items": {
          "type": "array"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "items", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile, delivery preferences, and role metadata isolated to owner and admin."
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminEntry" },
      "description": "Authoritative admin allowlist records."
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "ThriftHub marketplace product listings."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer Cash on Delivery orders."
    },
    "/carts/{userId}": {
      "schema": { "$ref": "#/entities/Cart" },
      "description": "Persistent shopping cart per authenticated user."
    }
  }
}
